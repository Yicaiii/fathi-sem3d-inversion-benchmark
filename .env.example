# Copy this file to .env and replace the example values.

# Temporary compatibility variable used by the current scripts.
# This should point to the repository root.
FATHI_BENCHMARK_ROOT=/path/to/fathi-sem3d-inversion-benchmark

# Absolute path to the compiled SEM3D executable.
SEM3D_EXE=/path/to/SEM3D/sem3d.exe

# Directory used for heavy runtime data, traces and iteration outputs.
# Prefer a disk or filesystem with sufficient free space.
FATHI_RUNTIME_ROOT=/path/to/fathi-runtime
